generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid())
  username   String    @unique
  password   String
  phone      String    @unique
  role       Role      @default(CLIENT)
  avatarSlug String?
  createdAt  DateTime  @default(now())

  employee Employee?
}

model BusinessSettings {
  id                String   @id @default(uuid())
  name              String
  phone             String
  whatsapp          String
  email             String
  address           String
  openTimeWeekday   String   @default("09:00")
  closeTimeWeekday  String   @default("18:00")
  closedWeekday     Boolean  @default(false)
  openTimeSaturday  String   @default("09:00")
  closeTimeSaturday String   @default("17:00")
  closedSaturday    Boolean  @default(false)
  openTimeSunday    String   @default("09:00")
  closeTimeSunday   String   @default("14:00")
  closedSunday      Boolean  @default(true)
  heroImageSlug     String?
  logoSlug          String?
  primaryColor      String   @default("#570df8")
  secondaryColor    String?
  accentColor       String?
  fontHeading       String?
  fontBody          String?
  instagramUrl      String?
  facebookUrl       String?
  tiktokUrl         String?
  youtubeUrl        String?
  homeContent       Json?
  updatedAt         DateTime @updatedAt
}

enum CampaignChannel {
  EMAIL
  WHATSAPP
  BOTH
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

enum CampaignSegment {
  ALL
  BIRTHDAY_MONTH
  INACTIVE
  BY_SERVICE
}

// Campaña de promoción a clientes (correo y/o WhatsApp) con segmentación.
model Campaign {
  id             String          @id @default(uuid())
  title          String
  body           String
  channel        CampaignChannel @default(EMAIL)
  segment        CampaignSegment @default(ALL)
  // Parámetro del segmento: serviceId (BY_SERVICE) o días de inactividad (INACTIVE).
  segmentParam   String?
  status         CampaignStatus  @default(DRAFT)
  recipientCount Int             @default(0)
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
}

// Galería/portafolio de la landing (fotos de trabajos o del local).
model GalleryImage {
  id        String   @id @default(uuid())
  slug      String
  caption   String?
  order     Int      @default(0)
  state     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Customer {
  id        String    @id @default(uuid())
  fullName  String
  phone     String    @unique
  email     String?
  birthDate DateTime?
  createdAt DateTime  @default(now())

  bookings Booking[]
  sales    Sale[]
}

model Employee {
  id        String    @id @default(uuid())
  fullName  String
  phone     String    @unique
  state     Boolean   @default(true)
  birthDate DateTime?
  urlImage  String?
  userId    String?   @unique
  createdAt DateTime  @default(now())

  user           User?                   @relation(fields: [userId], references: [id])
  services       EmployeeService[]
  appointments   Appointment[]
  scheduleBlocks EmployeeScheduleBlock[]
  sales          Sale[]
  deductions     EmployeeDeduction[]
  notifications  EmployeeNotification[]
}

enum DeductionType {
  ADVANCE // adelanto / préstamo
  PRODUCT // producto tomado del negocio
  OTHER
}

// Deducciones económicas del empleado (adelantos, préstamos, productos tomados)
// que se restan de lo que gana en el cierre diario.
model EmployeeDeduction {
  id         String        @id @default(uuid())
  employeeId String
  type       DeductionType @default(ADVANCE)
  amount     Decimal
  note       String?
  createdAt  DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
}

// Notificación in-app para el portal del empleado (campana).
model EmployeeNotification {
  id         String   @id @default(uuid())
  employeeId String
  type       String   @default("APPOINTMENT")
  title      String
  body       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, read])
}

model EmployeeScheduleBlock {
  id         String   @id @default(uuid())
  employeeId String
  date       String?
  dayOfWeek  Int?
  startTime  String
  endTime    String
  isFullDay  Boolean  @default(false)
  reason     String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Service {
  id            String   @id @default(uuid())
  name          String   @unique
  price         Decimal
  duration      Int
  state         Boolean  @default(true)
  discount      Decimal  @default(0)
  // Cuando es true, `price` se interpreta como "desde" y el precio real se
  // captura al finalizar la cita (Appointment.finalPrice).
  variablePrice Boolean  @default(false)
  categoryId    String?
  urlImage      String?
  description   String?
  createdAt     DateTime @default(now())

  category            ServiceCategory?     @relation(fields: [categoryId], references: [id])
  employees           EmployeeService[]
  appointments        Appointment[]
  packageItems        ServicePackageItem[]
  appointmentServices AppointmentService[]
}

model ServiceCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)
  state     Boolean  @default(true)
  createdAt DateTime @default(now())

  services Service[]
}

model EmployeeService {
  employeeId String
  serviceId  String
  commission Decimal  @default(0)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
}

// Combo/paquete de servicios con precio propio, reservable como una sola cita.
model ServicePackage {
  id          String   @id @default(uuid())
  name        String   @unique
  price       Decimal
  description String?
  urlImage    String?
  state       Boolean  @default(true)
  createdAt   DateTime @default(now())

  items        ServicePackageItem[]
  appointments Appointment[]
}

model ServicePackageItem {
  packageId String
  serviceId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([packageId, serviceId])
}

// Servicios que componen una cita (permite varios servicios por cita). El
// Appointment.serviceId sigue apuntando al servicio principal por compatibilidad.
model AppointmentService {
  appointmentId String
  serviceId     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model Appointment {
  id          String           @id @default(uuid())
  serviceId   String
  employeeId  String
  scheduledAt DateTime
  endsAt      DateTime
  state       AppointmentState @default(SCHEDULED)
  // Precio real cobrado; se usa para servicios de precio variable. Cuando es
  // null, los reportes usan Service.price.
  finalPrice  Decimal?
  // Cita creada a partir de un combo/paquete (opcional).
  packageId   String?
  // Marca de recordatorio enviado, para no duplicar (cron de recordatorios).
  reminderSentAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())

  service  Service              @relation(fields: [serviceId], references: [id])
  employee Employee             @relation(fields: [employeeId], references: [id])
  package  ServicePackage?      @relation(fields: [packageId], references: [id])
  services AppointmentService[]
  booking  Booking?

  @@index([employeeId, scheduledAt])
  @@index([scheduledAt])
}

model Booking {
  id            String    @id @default(uuid())
  appointmentId String    @unique
  customerId    String
  bookedAt      DateTime  @default(now())
  checkedInAt   DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model InventoryCategory {
  id    String          @id @default(uuid())
  name  String          @unique
  items InventoryItem[]
}

model InventoryItem {
  id          String             @id @default(uuid())
  name        String
  description String?
  quantity    Decimal            @default(0)
  unit        String             @default("unidad")
  minStock    Decimal            @default(0)
  cost        Decimal            @default(0)
  categoryId  String?
  category    InventoryCategory? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  price       Decimal
  realCost    Decimal  @default(0)
  saleCost    Decimal  @default(0)
  stock       Int      @default(0)
  commission  Decimal  @default(0)
  urlImage    String?
  state       Boolean  @default(true)
  createdAt   DateTime @default(now())

  saleItems SaleItem[]
}

model Sale {
  id              String   @id @default(uuid())
  customerId      String?
  employeeId      String?
  total           Decimal  @default(0)
  commissionTotal Decimal  @default(0)
  createdAt       DateTime @default(now())

  customer Customer?  @relation(fields: [customerId], references: [id])
  employee Employee?  @relation(fields: [employeeId], references: [id])
  items    SaleItem[]

  @@index([employeeId])
  @@index([createdAt])
}

model SaleItem {
  id               String  @id @default(uuid())
  saleId           String
  productId        String
  quantity         Int
  unitPrice        Decimal
  commissionPct    Decimal @default(0)
  lineTotal        Decimal
  commissionAmount Decimal @default(0)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
}

enum Role {
  CLIENT
  ADMIN
  EMPLOYEE
}

enum AppointmentState {
  SCHEDULED
  CANCELLED
  FINISHED
}
