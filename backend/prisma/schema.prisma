generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid())
  username   String    @unique
  password   String
  phone      String    @unique
  role       Role      @default(CLIENT)
  avatarSlug String?
  createdAt  DateTime  @default(now())

  employee Employee?
}

model BusinessSettings {
  id                String   @id @default(uuid())
  name              String
  phone             String
  whatsapp          String
  email             String
  address           String
  openTimeWeekday   String   @default("09:00")
  closeTimeWeekday  String   @default("18:00")
  closedWeekday     Boolean  @default(false)
  openTimeSaturday  String   @default("09:00")
  closeTimeSaturday String   @default("17:00")
  closedSaturday    Boolean  @default(false)
  openTimeSunday    String   @default("09:00")
  closeTimeSunday   String   @default("14:00")
  closedSunday      Boolean  @default(true)
  heroImageSlug     String?
  logoSlug          String?
  primaryColor      String   @default("#570df8")
  homeContent       Json?
  updatedAt         DateTime @updatedAt
}

model Customer {
  id             String   @id @default(uuid())
  fullName       String
  phone          String
  identification String   @unique
  createdAt      DateTime @default(now())

  bookings Booking[]
  sales    Sale[]

  @@index([phone])
}

model Employee {
  id        String   @id @default(uuid())
  fullName  String
  phone     String   @unique
  state     Boolean  @default(true)
  salary    Decimal  @default(0)
  userId    String?  @unique
  createdAt DateTime @default(now())

  user           User?                   @relation(fields: [userId], references: [id])
  services       EmployeeService[]
  appointments   Appointment[]
  scheduleBlocks EmployeeScheduleBlock[]
  sales          Sale[]
}

model EmployeeScheduleBlock {
  id         String   @id @default(uuid())
  employeeId String
  date       String?
  dayOfWeek  Int?
  startTime  String
  endTime    String
  isFullDay  Boolean  @default(false)
  reason     String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  price       Decimal
  duration    Int
  state       Boolean  @default(true)
  discount    Decimal  @default(0)
  urlImage    String?
  description String?
  createdAt   DateTime @default(now())

  employees    EmployeeService[]
  appointments Appointment[]
}

model EmployeeService {
  employeeId String
  serviceId  String
  commission Decimal  @default(0)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
}

model Appointment {
  id          String           @id @default(uuid())
  serviceId   String
  employeeId  String
  scheduledAt DateTime
  endsAt      DateTime
  state       AppointmentState @default(SCHEDULED)
  createdAt   DateTime         @default(now())

  service  Service  @relation(fields: [serviceId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  booking  Booking?

  @@index([employeeId, scheduledAt])
  @@index([scheduledAt])
}

model Booking {
  id            String    @id @default(uuid())
  appointmentId String    @unique
  customerId    String
  bookedAt      DateTime  @default(now())
  checkedInAt   DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model InventoryCategory {
  id    String          @id @default(uuid())
  name  String          @unique
  items InventoryItem[]
}

model InventoryItem {
  id          String             @id @default(uuid())
  name        String
  description String?
  quantity    Decimal            @default(0)
  unit        String             @default("unidad")
  minStock    Decimal            @default(0)
  cost        Decimal            @default(0)
  categoryId  String?
  category    InventoryCategory? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  price       Decimal
  stock       Int      @default(0)
  commission  Decimal  @default(0)
  urlImage    String?
  state       Boolean  @default(true)
  createdAt   DateTime @default(now())

  saleItems SaleItem[]
}

model Sale {
  id              String   @id @default(uuid())
  customerId      String?
  employeeId      String?
  total           Decimal  @default(0)
  commissionTotal Decimal  @default(0)
  createdAt       DateTime @default(now())

  customer Customer?  @relation(fields: [customerId], references: [id])
  employee Employee?  @relation(fields: [employeeId], references: [id])
  items    SaleItem[]

  @@index([employeeId])
  @@index([createdAt])
}

model SaleItem {
  id               String  @id @default(uuid())
  saleId           String
  productId        String
  quantity         Int
  unitPrice        Decimal
  commissionPct    Decimal @default(0)
  lineTotal        Decimal
  commissionAmount Decimal @default(0)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
}

enum Role {
  CLIENT
  ADMIN
  EMPLOYEE
}

enum AppointmentState {
  SCHEDULED
  CANCELLED
  FINISHED
}
