NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-must-be-at-least-16-chars
CORS_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

SUPABASE_STORAGE_URL=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Correo (Resend) — opcional. Sin esto, el envío de correos (campañas y
# recordatorios) queda inactivo (no-op) y la app funciona igual.
RESEND_API_KEY=
RESEND_FROM="Kaiser <onboarding@resend.dev>"

# WhatsApp (Twilio) — opcional. Sin esto, el envío de WhatsApp (campañas,
# recordatorios y confirmación de cita) queda inactivo (no-op) y la app
# funciona igual. TWILIO_WHATSAPP_FROM lleva el prefijo "whatsapp:".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Secreto del cron de recordatorios (Vercel Cron envía Authorization: Bearer).
# Obligatorio en producción para proteger /api/cron/reminders.
CRON_SECRET=
