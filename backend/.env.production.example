# Variables del BACKEND en producción (Vercel → Project Settings → Environment Variables).
# NO se commitea con valores reales; esto es solo la plantilla.

NODE_ENV=production

# Secreto para firmar JWT (mínimo 16 chars). Genera uno fuerte y único:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Dominio del FRONTEND (para CORS / defensa CSRF). Sin barra final.
#   ej: https://kaiser-ab-hair-studio.vercel.app
CORS_ORIGIN=

# Conexión a Postgres de Supabase. Para serverless usa el POOLER (puerto 6543,
# modo transaction). Dashboard: Project → Connect → "Transaction pooler".
#   ej: postgresql://postgres.oqequfqowyncmudsidty:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Almacenamiento de imágenes → Supabase Storage (S3).
STORAGE_DRIVER=s3
SUPABASE_STORAGE_URL=https://oqequfqowyncmudsidty.storage.supabase.co/storage/v1/s3
AWS_S3_REGION=us-east-1
# Dashboard: Project → Storage → S3 Connection → "New access key".
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Detrás del proxy de Vercel, para que el rate-limit vea la IP real del cliente.
TRUST_PROXY=1
